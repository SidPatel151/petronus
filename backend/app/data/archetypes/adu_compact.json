    "side_setback_ft": 4,
    "rear_setback_ft": 4,
    "front_setback_from_primary_home_ft": 6,
    "max_lot_coverage_pct": 50,
    "separate_address_required": false,
    "independent_entrance_required": true,
    "shared_utilities_allowed": true,
    "note": "CA law allows ADUs within 800 sqft with 4ft side/rear setbacks. Larger ADUs follow underlying zoning setbacks."
  },

  "ca_legal_limits": {
    "max_sqft": 1200,
    "max_stories": 2,
    "max_height_ft": 18,
    "independent_entrance": true,
    "citation": "CA Health & Safety Code §65852.2 (AB-68/AB-881, 2020)",
