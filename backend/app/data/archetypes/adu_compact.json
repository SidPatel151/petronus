    "stories_above_grade": [1, 2],
    "seismic_design_category": "D",
    "soft_story_risk": false,
    "roof_type": "flat_or_low_slope_shed",
    "roof_pitch_12": 2,
    "note": "Slab-on-grade dramatically simplifies MEP rough-in vs Victorian raised perimeter. Platform framing means each floor is structurally independent — stair opening requires doubled headers."
  },

