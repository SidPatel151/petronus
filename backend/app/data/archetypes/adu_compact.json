    "exterior_finish": "fiber_cement_or_wood_siding",
    "window_to_wall_ratio_min": 0.20,
    "note": "Modern CA ADU box aesthetic. Flat or low-slope shed roof with large windows. No porch. Independent entry door on front or side elevation."
  },

  "known_constraints_summary": [
    "CA law: max 1,200 sqft, 2 stories, 4ft side/rear setbacks — non-negotiable",
