  "wet_wall": {
    "location": "rear_spine_or_right_side",
    "fixed": true,
    "vertical_stack": true,
    "stack_diameter_in": 4,
    "note": "All wet rooms must stack vertically. Kitchen L1 must align under bath L2 to share a single DWV stack. In single-story plans, kitchen and bath share a horizontal wet wall on the right spine."
  },

  "staircase": {
    "location": "left_spine_or_center",
    "width_ft": 3.5,
    "run_direction": "front_to_back",
    "riser_in": 7.5,
    "tread_in": 10.0,
    "headroom_min_in": 80,
    "note": "Stair placed on non-wet side (left spine or center) so wet wall and stair don't compete for the same structural zone. Tight ADU stair: max 3.5ft wide, min 80in headroom (CBC 1011.3)."
  },

  "mep_routing_priority": ["dwv_gravity", "heat_pump_wh", "hvac", "supply_plumbing", "electrical"],

  "hvac": {
    "strategy": "mini_split",
    "ducted_central_allowed": false,
    "units_per_story": 1,
    "heat_pump_required": true,
    "gas_allowed": false,
    "outdoor_unit_location": "rear_yard_ground_mount",
    "refrigerant_line_routing": "through_exterior_wall_chase",
    "condensate_drain_required": true,
    "note": "Single mini-split per story is standard for CA ADU. Outdoor unit in rear yard keeps front facade clean. No ductwork — slab construction has no cavity for trunk lines."
  },

  "plumbing": {
    "dwv": {
      "material": "abs_or_pvc",
      "stack_type": "single_stack_shared",
      "stack_diameter_in": 4,
      "branch_slope_in_per_ft": 0.25,
      "max_branch_length_before_cleanout_ft": 50,
      "cleanout_at_base_of_stack": true,
      "cleanout_at_exterior_cleanout_tee": true,
      "building_drain_exit": "rear_slab_penetration",
      "sewer_lateral": {
        "diameter_in": 4,
        "material": "pvc_schedule_40",
        "slope_pct": 2.1,
        "run_length_ft_typical": 25,
        "exit_direction": "rear_toward_street_main_or_existing_hookup",
        "cleanout_at_property_line": true,
        "note": "CA code requires 1/4in/ft (2.08%) minimum. Use 2.1% for ADU laterals. If connecting to existing house lateral, verify capacity — ADU adds ~150 gpd."
      },
      "vent": {
        "through_roof": true,
        "combined_with_main_stack": true,
        "diameter_in": 3
      }
    },
    "supply": {
      "material": "pex_a",
      "routing": "under_slab_or_through_wall_chase",
      "hot_water_recirculation": false,
      "insulation_required": true
    },
    "water_heater": {
      "type": "heat_pump_water_heater",
      "brand_example": "Rheem ProTerra 40gal",
      "location": "utility_closet_or_exterior_alcove",
      "min_surrounding_volume_ft3": 450,
      "min_room_dimension_ft": 7,
      "condensate_drain_required": true,
      "note": "CA Title 24 mandates HPWH for new ADUs. 40gal is adequate for up to 2BR. Requires 450 ft³ surrounding air — in a compact ADU, an open utility closet with louver door counts."
    }
  },

  "electrical": {
    "panel_decision": {
      "threshold_sqft": 600,
      "under_threshold": {
        "type": "sub_panel",
        "amps": 60,
        "fed_from": "main_house_panel",
        "feeder_wire": "4/0 Al SER cable",
        "note": "ADU ≤600 sqft: 60A sub-panel fed from existing house main. Verify house main has headroom (typically 200A house leaves ~100A available)."
      },
      "over_threshold": {
        "type": "new_service_drop",
        "amps": 200,
        "meter_required": true,
        "utility_coordination": true,
        "note": "ADU >600 sqft: POCO requires dedicated meter and service drop. Coordinate with utility 4–12 weeks ahead."
      }
    },
    "panel_location": "exterior_accessible_or_garage_wall",
    "nec_clearance": {
      "width_in": 30,
      "depth_in": 36,
      "height_in": 78
    },
    "ev_charging": {
      "required_by_ca": true,
      "voltage": 240,
      "amps": 40,
      "location": "exterior_weather_proof_outlet_or_garage",
      "circuit_dedicated": true,
      "note": "CA Energy Code Sec. 150.1 — new detached ADU must have EV-ready circuit."
    },
    "solar": {
      "pv_required_by_ca": true,
      "note": "CA Title 24 2022 requires solar on new ADUs. Flat/shed roof: mount flush or low-tilt. Coordinate with utility interconnect.",
      "roof_area_target_sqft": 120,
      "inverter_location": "exterior_wall_or_sub_panel_adjacent"
    },
    "induction_cooktop": true,
    "outlets_per_room": 4,
    "exhaust_fans": true,
    "fire_alarms": true,
    "carbon_monoxide_detectors": true
  },

  "massing_hints": {
    "brief_shape": "rectangle",
    "roof_type": "flat_or_shed",
    "roof_pitch_12": 2,
    "entry_side": "front",
    "porch": false,
    "large_glazing_facade": "front_and_rear",
    "plan_shape": "compact_rectangle",
    "preferred_aspect_ratios": {
      "studio": 1.0,
