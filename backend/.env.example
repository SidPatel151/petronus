REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-change-this
ANTHROPIC_API_KEY=
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Photorealistic Blender render step (backend/blender_worker/, needs its own
# Python 3.13 venv with bpy installed — see backend/blender_worker/README.md).
