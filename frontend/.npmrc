# The lockfile pins three@0.164.1, but postprocessing@6.39.2 declares a peer of
# three >=0.168 and three-bvh-csg@0.0.18 declares >=0.179. npm's strict peer
# resolution (default since npm 7) therefore refuses to install, which is what
# fails the Vercel build — the tree here was originally resolved with this flag.
#
# This pins CI to the same resolution that builds and runs locally. The real fix
# is to align the three.js version with those peers; see the note in package.json.
legacy-peer-deps=true
